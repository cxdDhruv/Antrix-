# Contact form (web3forms.com)
NEXT_PUBLIC_WEB3FORMS_KEY=

# 3D printing orders are emailed through Gmail.
# Create an App Password: Google Account > Security > 2-Step Verification > App passwords
GMAIL_USER=you@gmail.com
GMAIL_APP_PASSWORD=
# Where orders land (defaults to GMAIL_USER)
ORDER_EMAIL_TO=info@antrix.solutions

# Large model uploads (>4MB) go to Vercel Blob. Set automatically when you
# connect a Blob store in Vercel > Storage; for local dev run `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
